<header class="fixed top-0 left-0 right-0 z-50 bg-base-100/95 backdrop-blur-sm border-b border-base-content/10">
  <div class="max-w-3xl mx-auto w-full flex items-center justify-between px-6 sm:px-8 h-14">
    <a href="/" class="flex items-center gap-1.5 no-underline hover:no-underline group" aria-label="Ming Liang — Home">
      <span class="text-primary text-xs">~</span>
      <logo class="fill-current w-5 h-5 text-base-content group-hover:text-primary transition-colors duration-200"></logo>
      <span class="text-xs font-medium text-base-content/85">/</span>
      <span class="text-xs font-medium text-base-content/85">mingliang</span>
    </a>
    <nav class="flex items-center gap-1 sm:gap-2 text-xs">
      <a href="/projects/" class="px-2 py-1 text-base-content/55 hover:text-primary hover:bg-primary/10 transition-colors duration-150 no-underline">
        <span class="text-primary/50">~/</span>projects
      </a>
      <a href="/posts/" class="px-2 py-1 text-base-content/55 hover:text-primary hover:bg-primary/10 transition-colors duration-150 no-underline">
        <span class="text-primary/50">~/</span>posts
      </a>
      <a href="/about/" class="px-2 py-1 text-base-content/55 hover:text-primary hover:bg-primary/10 transition-colors duration-150 no-underline">
        <span class="text-primary/50">~/</span>about
      </a>
      <button id="theme-toggle" aria-label="Toggle theme" class="ml-1 w-7 h-7 flex items-center justify-center text-base-content/55 hover:text-primary hover:bg-primary/10 transition-colors duration-150 cursor-pointer">
        <svg id="sun-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
        </svg>
        <svg id="moon-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 hidden">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<script webc:keep>
  (function() {
    const sunIcon = document.getElementById('sun-icon');
    const moonIcon = document.getElementById('moon-icon');

    const updateIcons = (theme) => {
      if (theme === 'terminal-dark') {
        sunIcon.classList.remove('hidden');
        moonIcon.classList.add('hidden');
      } else {
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
      }
    };

    const updateThemeColor = (theme) => {
      const color = theme === 'terminal-dark' ? '#232020' : '#f6f4f0';
      document.querySelectorAll('meta[name="theme-color"]').forEach(tag => {
        tag.setAttribute('content', color);
      });
    };

    // Migrate legacy theme names from the previous editorial design to the
    // new terminal themes. Keeps returning visitors on their saved preference.
    const resolveTheme = (storedTheme) => {
      if (storedTheme === 'editorial-dark' || storedTheme === 'forest') return 'terminal-dark';
      if (storedTheme === 'editorial' || storedTheme === 'nord') return 'terminal';
      if (storedTheme === 'terminal' || storedTheme === 'terminal-dark') {
        return storedTheme;
      }
      return 'terminal';
    };

    const theme = resolveTheme(localStorage.getItem('theme'));
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
    updateIcons(theme);
    updateThemeColor(theme);

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'terminal' ? 'terminal-dark' : 'terminal';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      updateIcons(next);
      updateThemeColor(next);
    });
  })();
</script>

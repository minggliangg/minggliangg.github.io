<div class="navbar bg-base-100 shadow-sm">
  <div class="max-w-4xl mx-auto w-full flex justify-between">
    <div class="flex-1">
      <a
        class="text-xl no-underline hover:no-underline active:bg-transparent"
        href="/"
      >
        <logo class="fill-current w-18 h-18"></logo
      ></a>
    </div>
    <div class="flex-none">
      <ul class="menu menu-horizontal px-2 gap-2 sm:px-6 sm:gap-4 md:px-10 md:gap-8 items-center">
      <li><a href="/projects/">Projects</a></li>
      <li><a href="/posts/">Posts</a></li>
      <li><a href="/about/">About</a></li>
      <li>
        <button id="theme-toggle" class="btn btn-ghost btn-circle" aria-label="Toggle theme">
          <svg id="sun-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
          </svg>
          <svg id="moon-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 hidden">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
          </svg>
        </button>
      </li>
    </ul>
  </div>
</div>

<script webc:keep>
  (function() {
    const sunIcon = document.getElementById('sun-icon');
    const moonIcon = document.getElementById('moon-icon');

    const updateIcons = (theme) => {
      if (theme === 'forest') {
        sunIcon.classList.remove('hidden');
        moonIcon.classList.add('hidden');
      } else {
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
      }
    };

    const theme = localStorage.getItem('theme') || 'nord';
    document.documentElement.setAttribute('data-theme', theme);
    updateIcons(theme);

    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'nord' ? 'forest' : 'nord';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      updateIcons(next);
    });
  })();
</script>

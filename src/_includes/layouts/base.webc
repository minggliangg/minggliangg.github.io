<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title @text="title"></title>
    <meta
      webc:keep
      name="description"
      :content="description ? description : meta.description"
    />
    <meta name="theme-color" content="#f9f8f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0f0f" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link webc:keep rel="icon" href="/favicons/favicon.ico" sizes="32x32" />
    <link webc:keep rel="icon" href="/favicons/icon.svg" type="image/svg+xml" />
    <link webc:keep rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />
    <link webc:keep rel="manifest" href="/favicons/manifest.webmanifest" />

    <!-- Stylesheet (includes the self-hosted @font-face) -->
    <link webc:keep rel="stylesheet" href="/styles/index.css" />
    <!-- Preload the variable font so it loads in parallel with the CSS -->
    <link
      webc:keep
      rel="preload"
      as="font"
      href="/fonts/inter-latin.woff2"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <header></header>
    <main class="px-8 pb-10 pt-24 max-w-5xl mx-auto w-full">
      <slot @raw="content" webc:nokeep></slot>
    </main>
    <footer></footer>
  </body>
</html>

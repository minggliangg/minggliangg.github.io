---
layout: layouts/base.webc
title: "Projects"
---

<div class="flex flex-col gap-8">
  <div>
    <h1 class="text-3xl font-bold">Projects</h1>
    <p class="text-base-content/70 mt-2">
      A collection of things I've built and learned from.
    </p>
  </div>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

    <!-- React Breakthrough Project Card -->
    <div class="card bg-base-200 shadow-lg hover:shadow-xl transition-shadow">
      <div class="card-body">
        <h2 class="card-title text-2xl">React Breakthrough</h2>

        <p class="text-base-content/80">
          A digital implementation of the abstract strategy board game Breakthrough.
          Features drag-and-drop gameplay, customizable board sizes (4x4 to 26x26),
          multiple themes, and responsive design.
        </p>

        <!-- Tech Stack Tags -->
        <div class="flex flex-wrap gap-2 mt-2">
          <span class="badge badge-primary badge-sm">React 19</span>
          <span class="badge badge-primary badge-sm">TypeScript</span>
          <span class="badge badge-primary badge-sm">Vite</span>
          <span class="badge badge-primary badge-sm">Tailwind CSS</span>
          <span class="badge badge-primary badge-sm">@dnd-kit</span>
        </div>

        <!-- Action Buttons -->
        <div class="card-actions justify-end mt-4">
          <a
            href="https://github.com/minggliangg/react-breakthrough"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline btn-sm gap-2"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </a>
          <a
            href="/react-breakthrough"
            class="btn btn-primary btn-sm gap-2"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            Live Demo
          </a>
        </div>
      </div>
    </div>

    <!-- Placeholder for future projects -->
    <div class="card bg-base-200/50 shadow-lg border-2 border-dashed border-base-content/20">
      <div class="card-body items-center justify-center text-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-base-content/40">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="16"></line>
          <line x1="8" y1="12" x2="16" y2="12"></line>

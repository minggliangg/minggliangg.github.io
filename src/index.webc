---
layout: layouts/base.webc
title: "Ming Liang's Page"
description: "Software engineer based in Singapore. Building web apps, exploring new technologies, and writing about what I learn."
---

<div class="flex flex-col gap-16">
  <!-- $ whoami -->
  <section class="flex flex-col gap-3 motion-rise">
    <div class="flex items-baseline gap-2 text-base-content/45">
      <span class="text-primary">$</span>
      <span class="text-sm">whoami</span>
    </div>
    <h1 class="text-4xl sm:text-6xl font-bold tracking-tighter leading-[1.05] text-base-content">
      Ming Liang<span class="cursor-blink text-primary">▋</span>
    </h1>
    <p class="text-base sm:text-lg font-light text-base-content/60 max-w-lg leading-relaxed">
      Software engineer based in Singapore. Building web apps, exploring new technologies.
    </p>
  </section>

  <hr class="border-base-content/10 motion-fade" />

  <!-- $ ls ~/recent -->
  <section class="flex flex-col gap-4 motion-rise motion-delay-1">
    <div class="flex items-baseline gap-2 text-base-content/45">
      <span class="text-primary">$</span>
      <span class="text-sm">ls ~/recent</span>
      <span class="text-base-content/30 text-xs">— last 5</span>
    </div>
    <div class="flex flex-col">
      <div webc:for="post of collections.posts.toReversed().slice(0, 5)" class="group">
        <a
          :href="post.url"
          class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4 py-3 border-b border-base-content/8 no-underline hover:no-underline"
        >
          <time
            class="text-xs text-base-content/45 shrink-0 sm:w-24"
            @text="post.date.toLocaleDateString('en-SG', { day: '2-digit', month: 'short', year: 'numeric' })"
          ></time>
          <span
            class="text-sm text-base-content group-hover:text-primary transition-colors duration-150"
            @text="post.data.title"
          ></span>
          <span class="hidden sm:inline text-primary/0 group-hover:text-primary/60 transition-colors duration-150 text-xs">→</span>
        </a>
      </div>
    </div>
    <a href="/posts/" class="self-start mt-2 text-xs text-primary hover:underline underline-offset-4 no-underline">
      <span class="text-primary/50">$</span> cat ~/posts/<span class="text-primary">all</span> →
    </a>
  </section>
</div>

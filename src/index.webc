title: "Ming Liang's Page"
---

<div class="flex flex-col gap-4">
  <h1 class="text-3xl font-bold">Hi, I am Ming Liang!</h1>
  <p class="text-xl font-normal">
    I'm a software engineer based in Singapore 🇸🇬
  </p>

  <h2 class="text-2xl font-bold">Posts</h2>
  <ul>
    <li webc:for="post of collections.posts">
      <a class="hover:underline" :href="post.url" @text="post.data.title"></a>
    </li>
  </ul>
</div>

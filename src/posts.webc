---
layout: layouts/base.webc
title: "Posts"
---

<div class="flex flex-col gap-4">
  <h1 class="text-3xl font-bold">Posts</h1>
  <a
    webc:for="post of collections.posts"
    :href="post.url"
    class="flex flex-col"
  >
    <p>
      <span
        class="text-sm text-stone-600 dark:text-stone-400 mr-2"
        @text="post.date.toLocaleDateString()"
      ></span>
      <span class="font-bold" @text="post.data.title"></span>
    </p>
  </a>
</div>
